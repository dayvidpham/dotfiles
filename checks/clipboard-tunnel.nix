# Integration: checks.${system}.clipboard-tunnel = import ./checks/clipboard-tunnel.nix {
#   inherit pkgs home-manager;
# };
{ pkgs, home-manager }:
let
  inherit (pkgs) lib;
  commandStub = name: pkgs.writeShellApplication {
    inherit name;
    text = ''
      ${lib.optionalString (name == "ssh") ''printf 'ssh\n' >> "$SSH_AUDIT_LOG"''}
      printf '%s\0' "$@" > "$ARGV_LOG"
      printf '%s' "''${SDL_MOUSE_RELATIVE_SYSTEM_SCALE:-}" > "$ARGV_LOG.scale"
      exit "''${STUB_EXIT:-0}"
    '';
  };
  ssh = commandStub "ssh";
  viewer = commandStub "vncviewer";
  moonlight = commandStub "moonlight-qt";
  scopeRunner = pkgs.writeShellApplication {
    name = "systemd-run";
    text = ''
      while [ "$1" != -- ]; do shift; done
      shift
      exec "$@"
    '';
  };
  base = {
    imports = [
      ../modules/home-manager/services/clipd
      ../modules/home-manager/services/clip-tunnel
      ../modules/home-manager/programs/remote-desktop
      ../modules/home-manager/programs/remote-audio-client
      ../modules/home-manager/services/remote-audio
    ];
    home.username = "fixture";
    home.homeDirectory = "/home/fixture";
    home.stateVersion = "25.11";
    CUSTOM.services.clip-tunnel.sshPackage = ssh;
    CUSTOM.programs.remote-desktop.viewer = viewer;
  };
  evaluate = modules: home-manager.lib.homeManagerConfiguration {
    inherit pkgs;
    extraSpecialArgs = {
      pkgs-unstable = pkgs // { moonlight-qt = moonlight; };
      osConfig = { };
    };
    modules = [ base ] ++ modules;
  };
  enabled = (evaluate [
    ../users/minttea/home.flowX13.nix
    ({ lib, ... }: {
      config.CUSTOM.programs.remote-audio-client.systemdPackage = scopeRunner;
      # Unrelated host options are inert in this isolated client fixture. The
      # real Flow X13 file still generates its actual Moonlight wrapper here.
      options.CUSTOM = {
        wayland = lib.mkOption { type = lib.types.attrs; default = { }; };
        services.syncthing = lib.mkOption { type = lib.types.attrs; default = { }; };
      };
    })
  ]).config;
  disabled = (evaluate [{ CUSTOM.programs.remote-desktop.enable = true; }]).config;
  custom = (evaluate [{
    CUSTOM.services.clipd = { enable = true; socketPath = "%t/alternate.sock"; };
    CUSTOM.services.clip-tunnel = {
      enable = true;
      host = "user@other-desktop";
      remoteSocketPath = "/run/user/1234/peer.sock";
    };
  }]).config;
  legacy = builtins.tryEval (evaluate [{
    CUSTOM.programs.remote-desktop.clipTunnel.enable = false;
  }]).activationPackage.drvPath;
  tunnelOptions = (import ../modules/home-manager/services/clip-tunnel {
    config = enabled;
    inherit pkgs lib;
  }).options.CUSTOM.services.clip-tunnel;
  service = enabled.systemd.user.services.clip-tunnel;
  customService = custom.systemd.user.services.clip-tunnel;
  # ExecStart is generated by production code. Recover its actual store wrapper,
  # rather than constructing another implementation for these tests.
  executable = unit: builtins.head (lib.splitString " " (builtins.head unit.Service.ExecStart));
  packageNamed = name: cfg: lib.findFirst (p: lib.getName p == name)
    (throw "missing generated ${name} package") cfg.home.packages;
  remoteDesktop = packageNamed "remote-desktop" enabled;
  disabledViewer = packageNamed "remote-desktop" disabled;
  moonlightWrapper = packageNamed "moonlight-qt" enabled;
in
assert lib.all (a: a.assertion) enabled.assertions;
assert !(disabled.systemd.user.services ? clip-tunnel);
assert !legacy.success;
assert lib.all (value: !(tunnelOptions.socketPath.type.check value)) [
  "relative.sock" "/tmp/colon:sock" "/tmp/white space" "/tmp/new\nline" "%h/clipd.sock" "/tmp/$EXPAND"
];
assert !(tunnelOptions.remoteSocketPath.type.check "%t/clipd.sock");
assert !(tunnelOptions.host.type.check "desktop%h");
assert service.Install.WantedBy == [ enabled.CUSTOM.services.clipd.systemdTarget ];
assert service.Unit.PartOf == service.Install.WantedBy;
assert service.Unit.Wants == [ "clipd.service" ];
assert builtins.elem "clipd.service" service.Unit.After;
assert !(service.Unit ? Requires);
assert service.Service.Restart == "always";
assert service.Service.RestartSec == 5;
assert service.Service.TimeoutStartSec == 15;
assert service.Service.TimeoutStopSec == 10;
assert !(service.Service ? ExecStop);
assert lib.hasInfix "AcceptClipboard=0" enabled.xdg.configFile."tigervnc/default.tigervnc".text;
assert lib.hasInfix "SendClipboard=0" enabled.xdg.configFile."tigervnc/default.tigervnc".text;
pkgs.runCommand "clipboard-tunnel-check" { nativeBuildInputs = [ pkgs.python3 ]; } ''
  export SSH_AUDIT_LOG="$TMPDIR/ssh-audit"
  export ARGV_LOG="$TMPDIR/ssh.argv"
  ${executable service} /run/user/1000/clipd.sock
  export ARGV_LOG="$TMPDIR/custom.argv"
  ${executable customService} /run/user/1234/alternate.sock
  export ARGV_LOG="$TMPDIR/failure.argv"
  if STUB_EXIT=255 ${executable service} /run/user/1000/clipd.sock; then
    echo 'SSH failure was swallowed by the generated tunnel wrapper' >&2
    exit 1
  fi

  export ARGV_LOG="$TMPDIR/viewer.argv"
  ${lib.getExe remoteDesktop} 2> "$TMPDIR/default.stderr"
  test ! -s "$TMPDIR/default.stderr"
  export ARGV_LOG="$TMPDIR/other.argv"
  ${lib.getExe remoteDesktop} elsewhere 5999 2> "$TMPDIR/other.stderr"
  export ARGV_LOG="$TMPDIR/disabled.argv"
  ${lib.getExe disabledViewer} elsewhere 5999 2> "$TMPDIR/disabled.stderr"
  test ! -s "$TMPDIR/disabled.stderr"
  export ARGV_LOG="$TMPDIR/moonlight.argv"
  ${lib.getExe moonlightWrapper} stream desktop Remote

  # Concurrent viewers still only execute viewers, and cannot touch the forward.
  ARGV_LOG="$TMPDIR/concurrent-vnc.argv" ${lib.getExe remoteDesktop} &
  vnc_pid=$!
  ARGV_LOG="$TMPDIR/concurrent-moonlight.argv" ${lib.getExe moonlightWrapper} stream desktop Remote &
  moonlight_pid=$!
  wait "$vnc_pid" "$moonlight_pid"

  python3 - <<'PY'
  import os
  from pathlib import Path
  root = Path(os.environ['TMPDIR'])
  def argv(name):
      return (root / (name + '.argv')).read_bytes().rstrip(b'\0').decode().split('\0')
  flags = ['-n', '-N', '-T', '-S', 'none']
  for option in ['ControlMaster=no', 'ControlPersist=no', 'ForkAfterAuthentication=no',
                 'BatchMode=yes', 'StrictHostKeyChecking=yes', 'ExitOnForwardFailure=yes',
                 'ConnectTimeout=10', 'ConnectionAttempts=1', 'ServerAliveInterval=30',
                 'ServerAliveCountMax=3']:
      flags += ['-o', option]
  assert argv('ssh') == flags + ['-R', '/run/user/1000/clipd.sock:/run/user/1000/clipd.sock', '--', 'desktop']
  assert argv('custom') == flags + ['-R', '/run/user/1234/peer.sock:/run/user/1234/alternate.sock', '--', 'user@other-desktop']
  assert argv('failure') == argv('ssh')
  assert argv('viewer') == ['desktop:5900']
  assert argv('other') == ['elsewhere:5999']
  assert argv('disabled') == ['elsewhere:5999']
  warning = (root / 'other.stderr').read_text()
  assert 'NOT connected to the viewed host' in warning
  assert 'still shares the clipboard with desktop' in warning
  assert 'CUSTOM.services.clip-tunnel.enable' in warning
  assert argv('moonlight') == ['stream', 'desktop', 'Remote']
  assert (root / 'moonlight.argv.scale').read_text() == '1'
  assert argv('concurrent-vnc') == ['desktop:5900']
  assert argv('concurrent-moonlight') == ['stream', 'desktop', 'Remote']
  assert (root / 'concurrent-moonlight.argv.scale').read_text() == '1'
  # No extra SSH invocation from either launcher, including concurrent launches.
  assert (root / 'ssh-audit').read_text().splitlines() == ['ssh', 'ssh', 'ssh']
  PY
  touch "$out"
''
