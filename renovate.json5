{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  // The runner image pins live in one Containerfile. Renovate tracks the pins
  // that have an upstream feed: the Ubuntu base digest (native dockerfile
  // manager), the actions/runner release, and the Docker CLI static tarball.
  // UBUNTU_SNAPSHOT has no upstream index (the snapshot service accepts any
  // timestamp after 2023-03-01 and publishes no listing), so it stays a
  // deliberate manual bump — move it together with the base digest and the apt
  // version pins, as the Containerfile header says.
  "customManagers": [
    {
      "customType": "regex",
      "description": "actions/runner release pinned by the runner container image",
      "managerFilePatterns": ["/modules/nixos/services/github-runner/container/Containerfile$/"],
      "matchStrings": ["ARG RUNNER_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "actions/runner",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Docker CLI static tarball pinned by the runner container image",
      "managerFilePatterns": ["/modules/nixos/services/github-runner/container/Containerfile$/"],
      "matchStrings": ["ARG DOCKER_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "custom.docker-static",
      "depNameTemplate": "docker",
      "extractVersionTemplate": "^docker-(?<version>\\d+\\.\\d+\\.\\d+)\\.tgz$",
      "versioningTemplate": "docker"
    }
  ],

  "customDatasources": {
    "docker-static": {
      "defaultRegistryUrlTemplate": "https://download.docker.com/linux/static/stable/x86_64/",
      "format": "html"
    }
  },

  "packageRules": [
    {
      "description": "Keep the runner base on its release line; refresh the digest only",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "Review every runner image pin change as one deliberate bump",
      "matchFileNames": ["modules/nixos/services/github-runner/container/Containerfile"],
      "groupName": "runner image pins",
      "prBodyNotes": [
        "Bump the matching `RUNNER_SHA256` / `DOCKER_SHA256` arg for any version change; the image build verifies the download against it."
      ]
    }
  ]
}
