Include config.d/*

Host csil-server
    HostName csil-cpu2.csil.sfu.ca

Host csil-tunnel
    HostName csil-cpu3.csil.sfu.ca

Host csil-client
    HostName csil-cpu6.csil.sfu.ca

Host *.csil.sfu.ca
    User dhpham
    Port 24

Host *.alliancecan.ca
    User dhpham
    Port 22

# NOTE: the clipd RemoteForward is intentionally NOT here. The graphical-session
# clip-tunnel.service owns one foreground, non-multiplexed `ssh -R` independently
# of VNC/Moonlight. It bypasses the interactive ControlMaster settings below.
# Clipboard sharing with its configured host continues even with no viewer.

Host *
    ControlPath ~/.ssh/socket.%r@%h:%p
    ControlMaster auto
    ControlPersist 2h

