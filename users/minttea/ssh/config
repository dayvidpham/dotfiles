Include config.d/*

Host csil-server
    HostName csil-cpu2.csil.sfu.ca

Host csil-tunnel
    HostName csil-cpu3.csil.sfu.ca

Host csil-client
    HostName csil-cpu6.csil.sfu.ca

Host *.csil.sfu.ca
    User dhpham
    Port 24

Host *.alliancecan.ca
    User dhpham
    Port 22

# NOTE: the clipd RemoteForward is intentionally NOT here. It is established
# per viewer session by the `remote-desktop` helper (a dedicated, non-multiplexed
# `ssh -R`), so it is not tied to a ControlMaster's lifetime and does not fight
# with interactive sessions over the same remote socket.

Host *
    ControlPath ~/.ssh/socket.%r@%h:%p
    ControlMaster auto
    ControlPersist 2h

