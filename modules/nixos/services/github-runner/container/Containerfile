# GitHub Actions runner container image (Ubuntu 26.04, Resolute Raccoon).
#
# Built by the github-runner NixOS module with rootless podman; the module owns
# the run flags. The runner works from a host-visible root directory so sibling
# containers started by jobs (service containers, `docker run` steps, job
# containers, e2e distro stacks) can bind mount workspace paths.
#
# Pinning: the base image is pinned by digest and apt installs from the dated
# Ubuntu snapshot below, so a rebuild reproduces the same package versions
# instead of tracking the live archive. Bump the digest and the snapshot
# together; the versions the snapshot resolves are listed beside the package
# set for review.
FROM docker.io/library/ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78

ENV DEBIAN_FRONTEND=noninteractive DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0
ARG RUNNER_VERSION=2.337.0
ARG DOCKER_VERSION=27.5.1
ARG UBUNTU_SNAPSHOT=20260917T000000Z

# The base image ships no CA store, so the first update bootstraps
# ca-certificates from the default plain-HTTP archive sources (APT still
# verifies the Release signatures), then every source is frozen to the dated
# snapshot and the real install pins the snapshot's exact versions.
# check-valid-until stays off because a pinned snapshot is intentionally older
# than the archive's moving validity window.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
  && sed -i -E \
       -e "s|https?://archive\.ubuntu\.com/ubuntu|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}|g" \
       -e "s|https?://security\.ubuntu\.com/ubuntu|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}|g" \
       /etc/apt/sources.list.d/ubuntu.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends --allow-downgrades \
       ca-certificates=20260601~26.04.1 \
       curl=8.18.0-1ubuntu2.5 \
       file=1:5.46-5build2 \
       git=1:2.53.0-1ubuntu1 \
       gh=2.46.0-4 \
       jq=1.8.1-4ubuntu2 \
       build-essential=12.12ubuntu2.26.04.2 \
       libicu78=78.2-2ubuntu1 \
       podman=5.7.0+ds2-3build1 \
       sudo=1.9.17p2-1ubuntu3 \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m runner \
  && echo "runner ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Static docker CLI: the runner shells out to `docker` for service containers,
# `docker run` steps, and job containers. Against the mounted host podman
# socket it must be the real docker client, not a podman symlink (nested
# podman cannot set up its inner userns).
RUN curl -fsSL -o /tmp/docker.tgz \
      "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz" \
  && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
  && install -m 0755 /tmp/docker/docker /usr/local/bin/docker \
  && rm -rf /tmp/docker.tgz /tmp/docker \
  && docker --version

WORKDIR /home/runner

RUN curl -fsSL -o runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" \
  && tar xzf runner.tar.gz \
  && rm runner.tar.gz \
  && ./bin/installdependencies.sh \
  && chown -R runner:runner /home/runner

COPY entrypoint.sh /usr/local/bin/github-runner-entrypoint
RUN chmod 0755 /usr/local/bin/github-runner-entrypoint

USER runner

ENTRYPOINT ["/usr/local/bin/github-runner-entrypoint"]
