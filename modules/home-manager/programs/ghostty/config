theme = Afterglow
command = zsh
font-size = 14
keybind = shift+enter=text:\x1b\r
# Never hand a launch off to an already-running instance. Single-instance uses
# the shared user D-Bus, so with multiple sessions (niri + a remote/waypipe
# sway) a new terminal would appear in whichever session owns the bus name.
gtk-single-instance = false
# Let programs read the clipboard via OSC52. Default is "ask", which does not
# work for TUI-driven reads (e.g. opencode's Ctrl+V), leaving paste empty.
# Tradeoff: any program running in the terminal can then read the clipboard
# without a prompt.
clipboard-read = allow
