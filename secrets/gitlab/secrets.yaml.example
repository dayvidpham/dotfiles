# GitLab container registry Personal Access Token (PAT) for dayvidpham-agent_bot
# Target repository: registry.gitlab.com/dayvidpham/humanoid/sfurs-runtime
# Required scopes: read_registry, write_registry
#
# First-time setup (on desktop, or with the portable user age key):
#   cp secrets/gitlab/secrets.yaml.example secrets/gitlab/secrets.yaml
#   # Replace the placeholder token below with the real PAT, then encrypt:
#   sops -e -i secrets/gitlab/secrets.yaml
#   # Stage the encrypted file so the Nix flake sees it before activating:
#   git add secrets/gitlab/secrets.yaml
#   ./switch.sh nixos
#
# To decrypt and view: sops -d secrets/gitlab/secrets.yaml
# To edit in place:    sops secrets/gitlab/secrets.yaml
gitlab_registry_humanoid_pat: glpat-xxxxxxxxxxxxxxxxxxxx
