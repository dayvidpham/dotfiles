# GitHub Actions self-hosted runner registration token
# Fine-grained PAT (organization) with "Self-hosted runners: Read and write".
# Create at: https://github.com/settings/personal-access-tokens/new
#
# Copy this to secrets.yaml and encrypt with: sops -e -i secrets.yaml
# To decrypt and view: sops -d secrets.yaml
# To edit in place: sops secrets.yaml
github_runner_pat: github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
