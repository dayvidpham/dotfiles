# GitHub Actions self-hosted runner registration token
# Fine-grained PAT (organization) with "Self-hosted runners: Read and write".
# Create at: https://github.com/settings/personal-access-tokens/new
#
# Copy this to secrets.yaml and encrypt with: sops -e -i secrets.yaml
# To decrypt and view: sops -d secrets.yaml
# To edit in place: sops secrets.yaml
github_runner_pat: github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App private key for the scale-set dispatcher (the per-job VM pool).
# Organization-owned app with repository permission "Variables: Read and
# write" (heartbeat) and organization permission "Self-hosted runners: Read
# and write" (scale sets, JIT configs). Generated once on the app page; paste
# the PEM verbatim under this key with:
#   sops set --value-file secrets.yaml '["github_app_private_key"]' app.pem
github_app_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  -----END RSA PRIVATE KEY-----
